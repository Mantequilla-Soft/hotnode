<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Statistics - Hot Node</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="nav-brand">
        <h1>🔥 <%= config.hotnode.name %></h1>
      </div>
      <ul class="nav-links">
        <li><a href="/">Dashboard</a></li>
        <li><a href="/pins">Pins</a></li>
        <li><a href="/stats" class="active">Stats</a></li>
        <li><a href="/settings">Settings</a></li>
        <li class="auth-section">
          <button id="loginBtn" class="btn btn-sm btn-secondary" style="display: <%= isAuthenticated ? 'none' : 'inline-block' %>;">
            🔒 Login
          </button>
          <button id="logoutBtn" class="btn btn-sm btn-secondary" style="display: <%= isAuthenticated ? 'inline-block' : 'none' %>;">
            🔓 Logout
          </button>
        </li>
      </ul>
    </div>
  </nav>

  <main class="container">
    <h2>System Statistics</h2>

    <div id="loadError" class="card danger-text" style="display: none;">
      ⚠️ Couldn't load statistics (<span id="loadErrorDetail"></span>). The numbers below are not current.
    </div>

    <!-- Summary Cards -->
    <div class="stats-grid" style="margin-bottom: 2rem;">
      <div class="stat-card">
        <div class="stat-icon">📊</div>
        <div class="stat-info">
          <div class="stat-label">Total Pins</div>
          <div class="stat-value" id="totalPins">-</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">📤</div>
        <div class="stat-info">
          <div class="stat-label">Pins Watched (90d)</div>
          <div class="stat-value" id="pinsWatched">-</div>
          <div class="stat-subtext" id="pinsWatchedSub">-</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🔄</div>
        <div class="stat-info">
          <div class="stat-label">Migrated (90d)</div>
          <div class="stat-value" id="migrated90">-</div>
          <div class="stat-subtext" id="migratedBytes">-</div>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🗑️</div>
        <div class="stat-info">
          <div class="stat-label">Storage Freed by GC (90d)</div>
          <div class="stat-value" id="storageFreed">-</div>
        </div>
      </div>
    </div>

    <!-- Period Selector Tabs -->
    <div class="card">
      <div class="tabs">
        <button class="tab-btn active" data-period="7">7 Days</button>
        <button class="tab-btn" data-period="30">30 Days</button>
        <button class="tab-btn" data-period="90">90 Days</button>
      </div>
    </div>

    <!-- Migration Stats -->
    <div class="card">
      <h3>📦 Migration Statistics</h3>
      <div class="stats-row" id="migrationStats">
        <div class="stat-item">
          <div class="stat-item-label">Successful</div>
          <div class="stat-item-value success-text" id="migrationSuccess">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label">Failed</div>
          <div class="stat-item-value danger-text" id="migrationFailures">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label">Max Retries Reached</div>
          <div class="stat-item-value warning-text" id="migrationMaxRetries">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label">Data Migrated</div>
          <div class="stat-item-value" id="migrationBytes">-</div>
        </div>
      </div>
    </div>

    <!-- Cleanup Stats -->
    <div class="card">
      <h3>🧹 Cleanup & Garbage Collection</h3>
      <div class="stats-row" id="cleanupStats">
        <div class="stat-item">
          <div class="stat-item-label">Invalid Pins Removed</div>
          <div class="stat-item-value" id="cleanupInvalid">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label" title="Unpinned by the retention rule: dormant content since dormancy-based retention, migrated content before that">Unpinned (retention)</div>
          <div class="stat-item-value" id="cleanupMigrated">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label">GC Runs</div>
          <div class="stat-item-value" id="gcRuns">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label">Storage Freed by GC</div>
          <div class="stat-item-value" id="gcFreed">-</div>
        </div>
      </div>
    </div>

    <!-- System Metrics -->
    <div class="card">
      <h3>💻 System Metrics</h3>
      <p class="text-muted" id="metricsSampledAt">Sampled every 6 hours</p>
      <div class="stats-row" id="systemMetrics">
        <div class="stat-item">
          <div class="stat-item-label">CPU (latest)</div>
          <div class="stat-item-value" id="cpuLatest">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label">CPU 24h avg / peak</div>
          <div class="stat-item-value" id="cpu24h">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label">Memory (latest)</div>
          <div class="stat-item-value" id="memoryLatest">-</div>
        </div>
        <div class="stat-item">
          <div class="stat-item-label">Disk (latest)</div>
          <div class="stat-item-value" id="diskLatest">-</div>
          <div class="stat-subtext" id="diskLatestSub"></div>
        </div>
      </div>
    </div>

    <!-- GC History -->
    <div class="card">
      <h3>🗑️ Recent Garbage Collection Runs</h3>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Run at</th>
              <th>Duration</th>
              <th>Freed</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody id="gcHistory">
            <tr><td colspan="4" class="text-muted">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <footer>
    <div class="container">
      <p>&copy; 2026 IPFS Hot Node Service v1.0.0</p>
    </div>
  </footer>

  <!-- Login Modal -->
  <div id="loginModal" class="modal" style="display: none;">
    <div class="modal-content">
      <h3>Admin Login</h3>
      <form id="loginForm">
        <input 
          type="password" 
          id="loginPassword" 
          placeholder="Enter admin password" 
          required 
          autocomplete="current-password"
        >
        <div class="modal-buttons">
          <button type="submit" class="btn btn-primary">Login</button>
          <button type="button" class="btn btn-secondary" onclick="hideLoginModal()">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script>
    // State management - separate periods for different sections
    let summaryPeriod = 7; // For the new stats (7/30/90 days)
    let summaryData = null;

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', async () => {
      await loadSummaryData();
      updateDisplayedStats();
      
      // Setup tab handlers for 7/30/90 day stats
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          e.target.classList.add('active');
          summaryPeriod = parseInt(e.target.dataset.period);
          updateDisplayedStats();
        });
      });
    });

    // Load summary data from API
    async function loadSummaryData() {
      try {
        const response = await fetch('/api/stats/summary/all');
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }
        summaryData = await response.json();
      } catch (error) {
        console.error('Failed to load summary data:', error);
        document.getElementById('loadErrorDetail').textContent = error.message;
        document.getElementById('loadError').style.display = 'block';
        // Leave summaryData null so the "-" placeholders stay instead of
        // rendering zeros that look like real numbers.
        summaryData = null;
        document.getElementById('gcHistory').innerHTML =
          '<tr><td colspan="4" class="text-muted">Unavailable</td></tr>';
      }
    }

    // SQLite timestamps ("YYYY-MM-DD HH:MM:SS") are UTC but carry no zone;
    // new Date() would read them as local time.
    function parseUTC(ts) {
      return new Date(String(ts).replace(' ', 'T') + (/[zZ]|[+-]\d\d:?\d\d$/.test(ts) ? '' : 'Z'));
    }

    function pct(value) {
      return value == null ? '-' : Number(value).toFixed(1) + '%';
    }

    function bytesOrZero(bytes) {
      return formatBytes(bytes || 0);
    }

    // Update displayed stats based on selected period (7/30/90 days)
    function updateDisplayedStats() {
      if (!summaryData) return;

      const periodKey = `days_${summaryPeriod}`;
      const pins = summaryData.pins || {};

      // Summary cards (always 90-day)
      document.getElementById('totalPins').textContent = (pins.total || 0).toLocaleString();
      document.getElementById('pinsWatched').textContent = (pins.watched_90d || 0).toLocaleString();
      document.getElementById('pinsWatchedSub').textContent =
        `of ${(pins.active || 0).toLocaleString()} still pinned · ${bytesOrZero(pins.watched_90d_bytes)}`;

      const migration90 = summaryData.migration?.days_90 || {};
      document.getElementById('migrated90').textContent = (migration90.success || 0).toLocaleString();
      document.getElementById('migratedBytes').textContent = bytesOrZero(migration90.bytes_migrated);

      // GC is what actually reclaims disk; unpinned/invalid bytes are only
      // freed BY a GC run, so adding them on top double-counted.
      document.getElementById('storageFreed').textContent = bytesOrZero(summaryData.cleanup?.days_90?.gc_bytes_freed);

      // Migration stats for selected period
      const migration = summaryData.migration?.[periodKey] || {};
      document.getElementById('migrationSuccess').textContent = (migration.success || 0).toLocaleString();
      document.getElementById('migrationFailures').textContent = (migration.failures || 0).toLocaleString();
      document.getElementById('migrationMaxRetries').textContent = (migration.max_retries || 0).toLocaleString();
      document.getElementById('migrationBytes').textContent = bytesOrZero(migration.bytes_migrated);

      // Cleanup stats for selected period
      const cleanup = summaryData.cleanup?.[periodKey] || {};
      document.getElementById('cleanupInvalid').textContent = (cleanup.invalid_removed || 0).toLocaleString();
      document.getElementById('cleanupMigrated').textContent = (cleanup.migrated_unpinned || 0).toLocaleString();
      document.getElementById('gcRuns').textContent = (cleanup.gc_runs || 0).toLocaleString();
      document.getElementById('gcFreed').textContent = bytesOrZero(cleanup.gc_bytes_freed);

      renderSystemMetrics(summaryData.system || {});
      renderGCHistory(summaryData.gc_history || []);
    }

    function renderSystemMetrics(system) {
      const latest = system.latest;
      document.getElementById('metricsSampledAt').textContent = latest
        ? `Latest sample ${formatRelativeTime(parseUTC(latest.timestamp))} (${parseUTC(latest.timestamp).toLocaleString()}) · sampled every 6 hours`
        : 'No samples recorded yet · sampled every 6 hours';

      document.getElementById('cpuLatest').textContent = pct(latest?.cpu);
      document.getElementById('cpu24h').textContent = `${pct(system.cpu_avg_24h)} / ${pct(system.cpu_max_24h)}`;
      document.getElementById('memoryLatest').textContent = pct(latest?.memory_percent);

      const disk = document.getElementById('diskLatest');
      disk.textContent = pct(latest?.disk_percent);
      disk.classList.remove('warning-text', 'danger-text');
      if (latest?.disk_percent >= 95) disk.classList.add('danger-text');
      else if (latest?.disk_percent >= 85) disk.classList.add('warning-text');
      document.getElementById('diskLatestSub').textContent = latest
        ? `${latest.disk_used_gb} / ${latest.disk_total_gb} GB`
        : '';
    }

    function renderGCHistory(runs) {
      const tbody = document.getElementById('gcHistory');
      tbody.replaceChildren();
      if (runs.length === 0) {
        const row = tbody.insertRow();
        const cell = row.insertCell();
        cell.colSpan = 4;
        cell.className = 'text-muted';
        cell.textContent = 'No GC runs recorded';
        return;
      }
      for (const run of runs) {
        const row = tbody.insertRow();
        row.insertCell().textContent = parseUTC(run.run_at).toLocaleString();
        row.insertCell().textContent = `${run.duration_seconds ?? 0}s`;
        row.insertCell().textContent = bytesOrZero(run.freed_bytes);
        const result = row.insertCell();
        result.textContent = run.error ? `Failed: ${run.error}` : 'OK';
        result.className = run.error ? 'danger-text' : 'success-text';
      }
    }
  </script>
</body>
</html>
