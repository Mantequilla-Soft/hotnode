<!-- Login with Hive Keychain (utils/auth.js). Only accounts in ALLOWED_USERS can change anything. -->
<div id="loginModal" class="modal" style="display: none;">
  <div class="modal-content">
    <h3>Log in with Hive Keychain</h3>
    <form id="loginForm">
      <input type="text" id="loginUser" placeholder="Hive account, e.g. meno" required
        autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="17">
      <p class="text-muted" style="font-size: 0.85rem; margin: 0.5rem 0 0;">
        Keychain asks you to sign a one-time message with your posting key. Nothing is broadcast.
      </p>
      <p id="loginError" class="login-error" role="alert" style="display: none;"></p>
      <div class="modal-buttons">
        <button type="submit" class="btn btn-primary" id="loginSubmit">Log in</button>
        <button type="button" class="btn btn-secondary" onclick="hideLoginModal()">Cancel</button>
      </div>
    </form>
  </div>
</div>
